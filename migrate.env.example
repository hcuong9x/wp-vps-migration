# Required
SOURCE_HOST=1.2.3.4
TARGET_HOST=5.6.7.8
SOURCE_DOMAIN=oldsite.com
# Same-domain migration (A -> B cung domain): dat TARGET_DOMAIN giong SOURCE_DOMAIN.
# Neu de trong TARGET_DOMAIN, script se tu dong dung SOURCE_DOMAIN.
TARGET_DOMAIN=staging-newsite.com

# Optional
SOURCE_STACK=webinoly
TARGET_STACK=webinoly
# SOURCE_SLUG=htdocs
# TARGET_SLUG=htdocs
# TARGET_URL=https://staging-newsite.com

# SSH
SSH_USER=root
SSH_OPTS='-o StrictHostKeyChecking=accept-new'

# Paths
SOURCE_BACKUP_ROOT=/root/wp-migration-backups
TARGET_INCOMING_DIR=/root/wp-migration-backups/incoming
