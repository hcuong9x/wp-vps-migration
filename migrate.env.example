# Required
SOURCE_HOST=1.2.3.4
TARGET_HOST=5.6.7.8
SOURCE_DOMAIN=oldsite.com
# Same-domain migration (A -> B cung domain): dat TARGET_DOMAIN giong SOURCE_DOMAIN.
# Neu de trong TARGET_DOMAIN, script se tu dong dung SOURCE_DOMAIN.
TARGET_DOMAIN=staging-newsite.com

# Optional
# Stack options: webinoly, tino, wptangtoc-ols
SOURCE_STACK=tino
TARGET_STACK=webinoly
# SOURCE_SLUG mac dinh: htdocs (webinoly), public_html (tino), html (wptangtoc-ols)
# TARGET_SLUG mac dinh: htdocs (webinoly), public_html (tino), html (wptangtoc-ols)
# TARGET_URL=https://staging-newsite.com

# Target DB credentials.
# Restore se tu doc tu wp-config.php cua site dich neu file do ton tai.
# Neu site dich chua co wp-config.php hoac auto-detect fail, mo 4 dong duoi va dien DB tren VPS B.
# TARGET_DB_NAME=wordpress_db
# TARGET_DB_USER=wordpress_user
# TARGET_DB_PASS='change-me'
# TARGET_DB_HOST=localhost

# SSH
SSH_USER=root
SSH_OPTS='-o StrictHostKeyChecking=accept-new'
# Tuy chon rieng theo huong ket noi:
SOURCE_SSH_OPTS='-i /root/.ssh/wp_migrate -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new'
# TARGET_SSH_OPTS='-o StrictHostKeyChecking=accept-new'
# Ep SOURCE dung key, khong hoi password (run-on-target mac dinh se bat):
SOURCE_KEY_ONLY=1
# Chay script ngay tren VPS B va copy truc tiep A -> B (khuyen nghi):
RUN_ON_TARGET=1

# Paths
SOURCE_BACKUP_ROOT=/root/wp-migration-backups
TARGET_INCOMING_DIR=/root/wp-migration-backups/incoming

# Storage cleanup (mac dinh toi uu dung luong):
# - Xoa backup tren VPS A sau khi copy + verify checksum sang VPS B.
# - Xoa archive incoming tren VPS B sau khi restore thanh cong.
DELETE_SOURCE_ARTIFACT=1
DELETE_TARGET_ARCHIVE=1
# Neu can giu file de rollback nhanh, dat =0
# DELETE_SOURCE_ARTIFACT=0
# DELETE_TARGET_ARCHIVE=0
